      <field>
        <name>preco_int</name>
        <type>Integer</type>
        <format/>
        <group/>
        <decimal/>
        <length>-1</length>
        <precision>-1</precision>
        <nullif/>
        <ifnull/>
        <trimtype>none</trimtype>
        <currency/>
      </field>
      <field>

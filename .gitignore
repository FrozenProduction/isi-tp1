# ---- Pentaho / Spoon -------------------------------------------------
.kettle/
*.kjb.bak
*.ktr.bak
logs/
*.log

# ---- Vídeos -----------------------------------------------------------
# a pasta videos/ tem o seu proprio .gitignore (ignora tudo la dentro menos ele proprio);
# aqui ficam so as gravacoes que apareçam esquecidas noutra pasta
*.mp4
*.mkv

# ---- Dados de trabalho -----------------------------------------------
# o JSON cru da API é regenerado em cada execução (4 MB de diff a cada run):
# fica fora do git, mas a pasta existe por causa do .gitkeep
dados/raw/*
!dados/raw/.gitkeep

# Exportações regeneráveis: o mesmo snapshot volta a produzi-las em segundos.
# Os agregados ficam (são pequenos e são a evidência que o dashboard lê).
dados/out/precos_limpos.csv
dados/out/rejeitados.csv
dados/out/nulos.csv

# ---- Notas de trabalho (privadas: ficam só no disco) -----------------
# o relatorio final entra mais tarde; as notas de apoio e as consultas de
# verificacao nao sao material do repositorio publico.
relatorio/00-notas-e-evidencias.md
relatorio/01-conformidade-enunciado.md
sql/99_verificacao.sql

# ---- Artefactos de construcao do relatorio (regeneraveis) -------------
# _relatorio.html, _preview.*, _pag*.png: saida do build_pdf.py e da revisao
relatorio/_*

# ---- Windows / editores ----------------------------------------------
Thumbs.db
desktop.ini
~$*
*.tmp

# ---- Segredos (nunca entram no repositório) --------------------------
.env
*.secret
*.password

# ---- Relatorio: fonte e ferramentas de build -------------------------
# o entregavel e o PDF; o markdown de origem e os scripts que o compoem
# ficam fora do repositorio.
relatorio/relatorio.md
relatorio/build_pdf.py
relatorio/gerar_diagramas.py
relatorio/img/logo-est.png
nodered/test-flows.mjs
relatorio/indices.json

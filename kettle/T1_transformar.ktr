<step>
    <name>Identificar nulos</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>ISI_TP1</connection>
    <sql>SELECT run_id, id_posto, nome, distrito, concelho, cod_postal, morada,
       latitude, longitude, preco_texto,
       CASE WHEN coalesce(cod_postal,'') = '' THEN 'cod_postal'
            WHEN coalesce(morada,'')      = '' THEN 'morada'
            WHEN coalesce(latitude,'')    = '' THEN 'latitude'
            WHEN coalesce(longitude,'')   = '' THEN 'longitude'
            WHEN coalesce(preco_texto,'') = '' THEN 'preco_texto'
       END AS campo_em_falta
FROM staging_preco
WHERE run_id = (SELECT max(run_id) FROM staging_preco)
  AND (coalesce(cod_postal,'') = '' OR coalesce(morada,'') = ''
       OR coalesce(latitude,'') = '' OR coalesce(longitude,'') = ''
       OR coalesce(preco_texto,'') = '');</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>

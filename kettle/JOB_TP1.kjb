    <entry>
      <name>Fechar execucao</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>UPDATE execucao SET
  n_linhas_lidas = (SELECT count(*) FROM staging_preco WHERE run_id = execucao.run_id),
  n_linhas_carregadas = (SELECT count(*) FROM fact_preco WHERE run_id = execucao.run_id),
  terminada_em = now(),
  estado = 'concluida'
WHERE run_id = (SELECT max(run_id) FROM staging_preco)</sql>
      <useVariableSubstitution>T</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>

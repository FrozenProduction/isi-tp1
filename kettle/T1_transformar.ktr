  <step>
    <name>Agregar por distrito</name>
    <type>GroupBy</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <all_rows>N</all_rows>
    <ignore_aggregate>N</ignore_aggregate>
    <field_ignore/>
    <directory>%%java.io.tmpdir%%</directory>
    <prefix>grp</prefix>
    <add_linenr>N</add_linenr>
    <linenr_fieldname/>
    <give_back_row>N</give_back_row>
    <group>
      <field>
        <name>distrito</name>
      </field>
      <field>
        <name>combustivel</name>
      </field>
      <field>
        <name>unidade</name>
      </field>
    </group>
    <fields>
      <field>
        <aggregate>n_postos</aggregate>
        <subject>preco</subject>
        <type>COUNT_ALL</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>preco_medio</aggregate>
        <subject>preco</subject>
        <type>AVERAGE</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>preco_min</aggregate>
        <subject>preco</subject>
        <type>MIN</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>preco_max</aggregate>
        <subject>preco</subject>
        <type>MAX</type>
        <valuefield/>
      </field>
    </fields>

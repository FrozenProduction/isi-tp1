                        "dataset": "isi_tp1",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select p.nome  as \"Posto\",\r\n       m.nome  as \"Marca\",\r\n       co.nome as \"Concelho\",\r\n       di.nome as \"Distrito\",\r\n       f.preco as \"Preço (€/L)\"\r\nfrom fact_preco f\r\njoin dim_posto p       on p.posto_id       = f.posto_id\r\njoin dim_combustivel c on c.combustivel_id = f.combustivel_id\r\nleft join dim_marca m  on m.marca_id       = p.marca_id\r\njoin dim_concelho co   on co.concelho_id   = p.concelho_id\r\njoin dim_distrito di   on di.distrito_id   = co.distrito_id\r\nwhere c.nome = 'Gasóleo simples'\r\n  and f.run_id = (select max(run_id) from fact_preco)\r\norder by f.preco asc\r\nlimit 10\r\n",

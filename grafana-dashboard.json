                      "kind": "DataQuery",
                      "spec": {
                        "dataset": "isi_tp1",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "with metas(nome, alvo) as (\r\n  values ('Gasóleo simples', 2.200), ('Gasolina simples 95', 2.140), ('GPL Auto', 1.000)\r\n)\r\nselect d.nome        as \"Distrito\",\r\n       c.nome        as \"Combustível\",\r\n       a.preco_medio as \"Preço Médio (€/L)\",\r\n       m.alvo        as \"Alvo (€/L)\"\r\nfrom agg_distrito_combustivel a\r\njoin dim_distrito d    on d.distrito_id    = a.distrito_id\r\njoin dim_combustivel c on c.combustivel_id = a.combustivel_id\r\njoin metas m           on m.nome           = c.nome\r\nwhere a.run_id = (select max(run_id) from agg_distrito_combustivel)\r\n  and a.preco_medio < m.alvo\r\norder by c.nome, a.preco_medio\r\n",
                        "sql": {
